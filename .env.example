# Proofline — environment. Copy to .env.local and fill in. Never commit .env.local.

# --- LLM provider -------------------------------------------------------
# auto (default): use an OpenAI-compatible API if LLM_API_KEY is set, else local Ollama if
#                 reachable, else semantic checks report UNVERIFIED explicitly.
# LLM_PROVIDER=auto

# Production — the deployed demo uses Groq's free tier (tested, sub-second):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=gsk_your-key-here
# (any OpenAI-compatible endpoint works; gpt-4o-mini-2024-07-18 also fine)

# Local development without a key (Ollama running on this machine):
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:4b
# LLM_OLLAMA_URL=http://localhost:11434

# Deterministic fake for tests:
# LLM_PROVIDER=mock
# LLM_MOCK_RESPONSE={"claim_type":"qualitative","candidate_fact_ids":[],"relation":"insufficient","confidence":0.9,"reason":"no fact applies","suggested_correction":null}
